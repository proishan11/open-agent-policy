      }
    },
    {
      "username": "eve@company.test",
      "email": "eve@company.test",
      "firstName": "Eve",
      "lastName": "Santos",
      "enabled": false,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "eve123", "temporary": false }
      ],
