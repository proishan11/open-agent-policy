{
  "realm": "oap-validation",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "support_l1", "description": "Level 1 support agent" },
      { "name": "support_l2", "description": "Level 2 support agent" },
      { "name": "support_manager", "description": "Support team manager" },
      { "name": "security_admin", "description": "Security administrator" }
    ]
  },
  "groups": [
    {
      "name": "support_l1",
      "realmRoles": ["support_l1"]
    },
    {
      "name": "support_l2",
      "realmRoles": ["support_l2"]
    },
    {
      "name": "support_managers",
      "realmRoles": ["support_manager"]
    },
    {
      "name": "security_admins",
      "realmRoles": ["security_admin"]
    },
    {
      "name": "support_platform",
      "realmRoles": []
    },
    {
      "name": "restricted_account_reviewers",
      "realmRoles": []
    }
  ],
  "users": [
