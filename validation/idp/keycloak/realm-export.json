      }
    },
    {
      "username": "dana@company.test",
      "email": "dana@company.test",
      "firstName": "Dana",
      "lastName": "Reeves",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dana123", "temporary": false }
      ],
      "realmRoles": ["security_admin"],
      "groups": ["security_admins"],
      "attributes": {
        "region": ["global"],
