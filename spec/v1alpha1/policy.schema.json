{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oap.dev/spec/v1alpha1/policy.schema.json",
  "title": "OAP Agent Policy",
  "description": "Defines authorization rules for agents. This is the canonical policy format — all examples in the PRD and architecture are consolidated into this single shape.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "oap.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "AgentPolicy"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "namespace"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["subject", "rules"],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "object",
          "description": "Which agent(s) this policy applies to. Exactly one selector must be specified.",
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string",
              "description": "Match a specific agent by ID. Format: agent://<namespace>/<name>"
            },
            "agentType": {
              "type": "string",
              "description": "Match all agents of a given type.",
              "enum": ["workflow_agent", "chat_agent", "autonomous_agent", "pipeline_agent", "tool_agent"]
            },
            "agentNamespace": {
              "type": "string",
              "description": "Match all agents in a namespace."
            },
            "allAgents": {
              "type": "boolean",
              "description": "If true, this policy applies to all agents. Used for global deny policies."
            }
          },
          "oneOf": [
            { "required": ["agent"] },
            { "required": ["agentType"] },
            { "required": ["agentNamespace"] },
            { "required": ["allAgents"] }
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "description": "Authorization rules evaluated in order.",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["effect", "actions"],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["allow", "deny", "require_approval", "require_delegation"],
          "description": "The effect of this rule."
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Actions this rule applies to."
        },
        "resources": {
          "type": "object",
          "description": "Resource scope for this rule.",
          "additionalProperties": false,
          "properties": {
            "types": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Resource types this rule applies to."
            },
            "classificationMax": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "restricted"],
              "description": "Maximum data classification this rule covers."
            },
            "environments": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["development", "staging", "production"]
              },
              "description": "Environments this rule applies to."
            },
            "owners": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Resource owners this rule applies to."
            }
          }
        },
        "conditions": {
          "type": "object",
          "description": "Boolean prerequisites. If any condition is not met, the rule does not match.",
          "additionalProperties": true,
          "properties": {
            "actorRequired": {
              "type": "boolean",
              "description": "If true, an actor must be present in the request."
            },
            "actorType": {
              "type": "string",
              "enum": ["user", "service", "agent"],
              "description": "Required actor type."
            },
            "actorId": {
              "type": "string",
              "description": "Specific actor ID required."
            },
            "actorGroups": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Actor must belong to at least one of these groups."
            },
            "environment": {
              "type": "string",
              "enum": ["development", "staging", "production"],
              "description": "Required environment."
            },
            "minAuthStrength": {
              "type": "string",
              "enum": ["none", "password", "mfa", "phishing_resistant_mfa"],
              "description": "Minimum authentication strength required."
            },
            "timeWindow": {
              "type": "object",
              "description": "Time-based condition.",
              "additionalProperties": false,
              "properties": {
                "after": { "type": "string", "format": "time" },
                "before": { "type": "string", "format": "time" },
                "daysOfWeek": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
                }
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "description": "Restrictions applied to the granted access. Only valid for effect: allow.",
          "additionalProperties": true,
          "properties": {
            "readonly": {
              "type": "boolean",
              "description": "If true, only read operations are permitted."
            },
            "maxRecords": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of records."
            },
            "redact": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Fields to redact from responses."
            },
            "expiresIn": {
              "type": "string",
              "description": "Grant expiry duration. Format: 15m, 1h, 24h",
              "pattern": "^[0-9]+(s|m|h)$"
            }
          }
        },
        "obligations": {
          "type": "object",
          "description": "Requirements that must be fulfilled.",
          "additionalProperties": true,
          "properties": {
            "audit": {
              "type": "boolean"
            },
            "logFullRequest": {
              "type": "boolean"
            },
            "notify": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "approval": {
          "type": "object",
          "description": "Approval configuration. Only valid for effect: require_approval.",
          "additionalProperties": false,
          "properties": {
            "approvers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Who can approve. Format: user:<id> or group:<name>"
            },
            "minApprovals": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of approvals required."
            },
            "expiresIn": {
              "type": "string",
              "description": "How long the approval request is valid.",
              "pattern": "^[0-9]+(s|m|h)$"
            }
          }
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation for this rule."
        },
        "failMode": {
          "type": "string",
          "enum": ["open", "closed"],
          "default": "closed",
          "description": "Behavior when evaluation fails. Default: closed (deny)."
        }
      }
    }
  }
}
